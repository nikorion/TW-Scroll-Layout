{
  "description": "TW-Scroll-Layout development wiki",
  "plugins": [
    "tiddlywiki/filesystem",
    "tiddlywiki/tiddlyweb",
    "tiddlywiki/highlight",
    "nikorion/scroll-layout",
    "nikorion/detect-language"
  ],
  "themes": [
    "tiddlywiki/vanilla"
  ],
  "languages": [
    "fr-FR"
  ],
  "pluginPath": "../src",
  "config": {
    "retain-original-tiddler-path": true
  },
  "build": {
    "plugin-json": [
      "--output", "dist",
      "--render", "$:/core/templates/exporters/JsonFile", "TW-Scroll-Layout-Plugin.json", "text/plain", "", "exportFilter", "[[$:/plugins/nikorion/scroll-layout]]"
    ],
    "html": [
      "--output", "docs",
      "--rendertiddler", "$:/core/save/all", "TW-Scroll-Layout-Wiki.html", "text/plain", "",
      "publishFilter", "-[[$:/config/SyncFilter]] -[[$:/config/FileSystemPaths]] -[[$:/config/OriginalTiddlerPaths]] -[[$:/plugins/wikilabs/link-to-tabs]] -[[$:/plugins/kookma/commander]] -[[$:/plugins/oeyoews/tiddlywiki-codemirror-6]]"
    ]
  }
}
