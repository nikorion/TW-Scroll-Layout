title: $:/plugins/nikorion/scroll-layout/styles/styles
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

\rules except dash

<$reveal state="$:/layout" type="match" text="$:/plugins/nikorion/scroll-layout/layout" default="">
@media (min-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {

	{{$:/plugins/nikorion/scroll-layout/styles/base.css}}

	/* Defaults are shipped as shadow tiddlers (default-config.multids) at these
	   same config titles: a real tiddler of the same title overrides the shadow,
	   so transclusion below already resolves to the effective value.
	   $text (not {{...}}) because a plain transclusion wikifies the value with the
	   TARGET tiddler's parse rules — our own "\rules except dash" does not carry
	   over — so any value containing "--" (e.g. the shipped default
	   var(--tpc-primary)) gets its dashes turned into an en-dash, producing an
	   invalid var() name. In Gecko that poisons the single scrollbar-color
	   property, silently reverting BOTH thumb and track to browser defaults. */
	:root {
		--nk-scrollbar-width:             <$text text={{$:/config/nikorion/scroll-layout/scrollbar-width}}/>;
		--nk-scrollbar-width-mode:        <$text text={{$:/config/nikorion/scroll-layout/scrollbar-width-mode}}/>;
		--nk-scrollbar-radius:            <$text text={{$:/config/nikorion/scroll-layout/scrollbar-radius}}/>;
		--nk-scrollbar-thumb-color:       <$text text={{$:/config/nikorion/scroll-layout/scrollbar-thumb-color}}/>;
		--nk-scrollbar-thumb-hover-color: <$text text={{$:/config/nikorion/scroll-layout/scrollbar-thumb-hover-color}}/>;
		--nk-scrollbar-track-color:       <$text text={{$:/config/nikorion/scroll-layout/scrollbar-track-color}}/>;
	}

	/* Sticky tiddler title — gated on the vanilla stickytitles option so that disabling it
	   in theme settings also disables it here (we would otherwise override vanilla's own gate). */
	<$reveal state="$:/themes/tiddlywiki/vanilla/options/stickytitles" type="match" text="yes">
	.tc-tiddler-title {
		position: -webkit-sticky;
		position: sticky;
		top: 0;
		z-index: 500;
		background-color: var(--tpc-tiddler-background);
	}
	/* tc-tiddler-stuck: title has detached from its frame (frame scrolled above viewport).
	   Negative margins extend the bar edge-to-edge; box-shadow signals the detach visually.
	   nk-stuck-margin drives both the negative margin and the compensating padding. */
	.tc-tiddler-title.tc-tiddler-stuck {
		margin-left:   -42px;
		margin-right:  -42px;
		padding-left:  42px;
		padding-right: 42px;
		box-shadow:    0 2px 6px rgba(0,0,0,0.2);
	}
	</$reveal>


	/* Sidebar layout: the plugin does NOT define its own river/sidebar geometry — widths and
	   gaps come from the standard vanilla theme (Theme Tweaks metrics, transcluded directly
	   because the core --tp-story-width/--tp-sidebar-width custom properties are not
	   available on every supported TW version, plus vanilla's hard-coded 42px gutters /
	   3em hidden-sidebar padding). The
	   rules below only reposition the river's scrollbar so that the story content width
	   never depends on the scrollbar the browser draws (thin/auto/none): the real scrollbar
	   width is measured by startup.js into --nk-scrollbar-real-width (fallback 0px = pure
	   vanilla geometry) and the neighbouring whitespace absorbs the variation. */

	/* Fixed-fluid: vanilla gives the river left:storyleft, width:storywidth, 42px paddings.
	   The right-hand padding is folded into the width so the scrollbar sits glued to the
	   story content at the LEFT of the 42px gutter; the measured width is added back so the
	   content keeps the exact vanilla width (storywidth - 84px). The sidebar's transparent
	   overlap band (vanilla margin-left:-42px + padding-left:42px) is shrunk by the same
	   amount so the fixed sidebar never covers the scrollbar — its content does not move.
	   When the sidebar is hidden the scrollbar lives at the right edge of the viewport and
	   the 42px padding is reduced by the measured width instead. */
	<$reveal state="$:/themes/tiddlywiki/vanilla/options/sidebarlayout" type="match" text="fixed-fluid">

	<$reveal state="$:/state/sidebar" type="match" text="yes" default="yes">
	/* max(): vanilla's storywidth and tiddlerwidth metrics are NOT linked — vanilla lets
	   frames wider than the river simply overflow visibly. Here the river is a clipping
	   scroll container, so instead the river grows to fit an oversized tiddlerwidth
	   (storywidth - 84px content when tiddlerwidth fits, tiddlerwidth otherwise, border-box:
	   42px left padding + the reserved scrollbar gutter), keeping the scrollbar glued to the
	   story column's real right edge in both cases. */
	.tc-story-river {
		padding-right: 0;
		width: calc(max({{$:/themes/tiddlywiki/vanilla/metrics/storywidth}} - 42px, {{$:/themes/tiddlywiki/vanilla/metrics/tiddlerwidth}} + 42px) + var(--nk-scrollbar-real-width, 0px));
	}
	.tc-sidebar-scrollable {
		margin-left: calc(-42px + var(--nk-scrollbar-real-width, 0px));
		padding-left: calc(42px - var(--nk-scrollbar-real-width, 0px));
	}
	</$reveal>

	<$reveal state="$:/state/sidebar" type="nomatch" text="yes" default="yes">
	.tc-story-river {
		padding-right: calc(42px - var(--nk-scrollbar-real-width, 0px));
	}
	</$reveal>

	</$reveal>


	/* Fluid-fixed: vanilla gives the river width:auto, margin-right:sidebarwidth,
	   padding-right:0 — so the story content butts straight against the sidebar, with no free
	   space mirroring the 42px gutter on the left. The margin is widened by 42px to restore that
	   symmetry: the river is the fluid element here, so the gutter is taken from the river and
	   the fixed sidebar keeps its exact vanilla geometry (no narrowing, nothing to shift).
	   padding-right stays 0 so the scrollbar remains glued to the story content: a scroll
	   container draws its scrollbar OUTSIDE its own padding, against the border edge, so any
	   padding-right would push the bar away from the content and over to the sidebar side.
	   The measured scrollbar width is then subtracted from the margin so the bar is drawn INSIDE
	   the 42px gutter: the total river-to-sidebar distance stays exactly 42px, matching the left
	   gutter, with the scrollbar at its left end — next to the content it actually scrolls, and
	   not to be mistaken for the sidebar's own scrollbar. When the sidebar is hidden, vanilla's
	   3em padding-right hosts the scrollbar: it is reduced by the measured width instead. */
	<$reveal state="$:/themes/tiddlywiki/vanilla/options/sidebarlayout" type="match" text="fluid-fixed">

	<$reveal state="$:/state/sidebar" type="match" text="yes" default="yes">
	.tc-story-river {
		margin-right: calc({{$:/themes/tiddlywiki/vanilla/metrics/sidebarwidth}} + 42px - var(--nk-scrollbar-real-width, 0px));
	}
	</$reveal>

	<$reveal state="$:/state/sidebar" type="nomatch" text="yes" default="yes">
	.tc-story-river {
		padding-right: calc(3em - var(--nk-scrollbar-real-width, 0px));
	}
	</$reveal>

	</$reveal>

}
</$reveal>
